# ==========================================
# CyberVault Git Ignore Configuration
# ==========================================

# Sensitive User Data & Encrypted Vault Databases (NEVER COMMIT TO GIT)
data/config.json
data/vault.db
data/*.db
data/*.json
*.key
*.hash
*.cybervault
*.csv

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS System Files
Thumbs.db
Desktop.ini
.DS_Store

# Temporary & Scratch Files
scratch/
*.log
*.tmp
